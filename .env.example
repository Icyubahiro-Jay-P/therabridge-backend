PORT=5000
# Set this to your production frontend URL (e.g. https://therabridge.vercel.app)
CLIENT_URL=http://localhost:5173

# MongoDB - replace with your Atlas URI or use local
MONGO_URI=mongodb://localhost:27017/therabridge

# JWT signing secret. MUST be at least 32 characters and NOT a placeholder -
# the server refuses to boot with a weak/placeholder secret. Generate one per
# environment with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Gmail requires an App Password (regular account passwords are blocked).
# Enable 2-Step Verification on the account, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it here.
EMAIL_USER=you@example.com
EMAIL_PASS=your_gmail_app_password

# Global Email Settings
FROM_NAME=Therabridge
FROM_EMAIL=no-reply@therabridge.com

# Email delivery: EITHER SMTP (below) OR Resend HTTP API.
#
# Resend (https://resend.com) sends over HTTPS (port 443) and therefore works
# on hosts that block outbound SMTP - e.g. Render's free tier blocks SMTP
# ports 25/465/587. Set EMAIL_PROVIDER=resend and add your API key.
# When RESEND_FROM is unset the code sends from "onboarding@resend.dev"
# (Resend's built-in test sender) - which only delivers to the inbox the
# Resend account was registered with. For real user-facing email, verify a
# domain in Resend and set RESEND_FROM to a sender on it.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Therabridge <noreply@yourdomain.com>

NODE_ENV = development

# AI Service (Python ML microservice)
AI_SERVICE_URL = http://localhost:8000

GEMINI_API_KEY = your gemini api key here

# Web Push (device notifications) - generate keys with: npm run vapid
VAPID_PUBLIC_KEY = your_vapid_public_key_here
VAPID_PRIVATE_KEY = your_vapid_private_key_here
VAPID_SUBJECT = mailto:no-reply@therabridge.com

# Field-level encryption (AES-256-GCM) - generate a 32-byte hex key (64 chars):
#   openssl rand -hex 32
# Used to encrypt DM content, mood notes, crisis descriptions, Therry messages,
# notification previews, and community messages at rest. Lose the key and the
# data is unrecoverable - back it up per environment.
FIELD_ENCRYPTION_KEY=your_64_char_hex_key_here

# Cloudinary - profile pictures are stored here (server disk is wiped on every
# Render deploy). Create a free account at https://cloudinary.com and grab the
# Cloud name, API Key, and API Secret from the Dashboard.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
