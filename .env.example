PORT=5000
# Set this to your production frontend URL (e.g. https://therabridge.vercel.app)
CLIENT_URL=http://localhost:5173

# MongoDB — replace with your Atlas URI or use local
MONGO_URI=mongodb://localhost:27017/therabridge

JWT_SECRET=therabridgejwtsecret_change_in_production

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your gmail smtp account email here
EMAIL_PASS=your gmail app password here

# Global Email Settings
FROM_NAME=Therabridge
FROM_EMAIL=no-reply@therabridge.com

# Switch to "production" in production for secure cookies + CORS
NODE_ENV=development