PORT=5000
# Set this to your production frontend URL (e.g. https://therabridge.vercel.app)
CLIENT_URL=http://localhost:5173

# MongoDB - replace with your Atlas URI or use local
MONGO_URI=mongodb://localhost:27017/therabridge

# JWT signing secret. MUST be at least 32 characters and NOT a placeholder -
# the server refuses to boot with a weak/placeholder secret. Generate one per
# environment with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Google Apps Script Web App URL for sending transactional emails (verification
# codes, password resets). Deploy the script from google-apps-script.js in the
# project root as a Web App (Execute as: Me, Access: Anyone). The full URL looks
# like: https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_SCRIPT_URL=your_google_apps_script_web_app_url

NODE_ENV=development

GEMINI_API_KEY=your_gemini_api_key_here

# Web Push (device notifications) - generate keys with: npm run vapid
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:no-reply@therabridge.com

# Field-level encryption (AES-256-GCM) - generate a 32-byte hex key (64 chars):
#   openssl rand -hex 32
# Used to encrypt DM content, mood notes, crisis descriptions, Therry messages,
# notification previews, and community messages at rest. Lose the key and the
# data is unrecoverable - back it up per environment.
FIELD_ENCRYPTION_KEY=your_64_char_hex_key_here

# Cloudinary - profile pictures are stored here (server disk is wiped on every
# Render deploy). Create a free account at https://cloudinary.com and grab the
# Cloud name, API Key, and API Secret from the Dashboard.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis - used for caching, rate limiting, idempotency, job queues, and
# Socket.IO adapter for horizontal scaling. Defaults to localhost for dev.
# In Docker, use: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Stripe - payments/subscriptions. Set STRIPE_SECRET_KEY to enable checkout;
# STRIPE_WEBHOOK_SECRET is used to verify the /api/billing/webhook signature
# (stripe listen --forward-to localhost:5000/api/billing/webhook). STRIPE_PRICE_ID
# is the recurring monthly plan price; STRIPE_CURRENCY defaults to usd.
# Session pricing lives per-therapist (therapist profile -> sessionPrice), paid
# per-session via one-time Checkout.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID=your_stripe_price_id
STRIPE_CURRENCY=usd
